{
  "name": "dexa-wfh-attendance-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && concurrently --kill-others-on-fail -n employee,attendance,gateway \"npm:start:employee\" \"npm:start:attendance\" \"npm:start:gateway\"",
    "start:employee": "node --env-file-if-exists=.env dist/employee/main.js",
    "start:attendance": "node --env-file-if-exists=.env dist/attendance/main.js",
    "start:gateway": "node --env-file-if-exists=.env dist/gateway/main.js",
    "lint": "oxlint --type-aware src/",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
